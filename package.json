{
  "name": "desktop-pixel-clock",
  "version": "1.3.2",
  "description": "Retro Cyberpunk Desktop Pixel Clock & Modular Widget",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64",
    "dist:arm64": "electron-builder --mac dmg --arm64",
    "dist:x64": "electron-builder --mac dmg --x64",
    "dist:all": "electron-builder --mac dmg --arm64 --x64",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "com.antigravity.pixelclock",
    "productName": "MarketPulseClock",
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": 1
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarketPulseClock"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "pixel-clock",
    "electron",
    "widget",
    "dot-matrix",
    "cyberpunk"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
