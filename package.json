{
  "name": "desktop-pixel-clock",
  "version": "1.3.3",
  "description": "Retro Cyberpunk Desktop Pixel Clock & Modular Widget",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64",
    "dist:arm64": "electron-builder --mac dmg --arm64",
    "dist:x64": "electron-builder --mac dmg --x64",
    "dist:all": "electron-builder --mac dmg --arm64 --x64",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "com.antigravity.pixelclock",
    "productName": "像素时钟",
    "icon": "build/icon.png",
    "afterPack": "build/afterPack.js",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MarketPulseClock-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "像素时钟",
      "uninstallDisplayName": "像素时钟",
      "artifactName": "MarketPulseClock-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "MarketPulseClock-${version}-portable.${ext}"
    },
    "dmg": {
      "background": "build/dmg-background.tiff",
      "iconSize": 90,
      "window": {
        "width": 640,
        "height": 510
      },
      "contents": [
        {
          "x": 110,
          "y": 70,
          "type": "file",
          "path": "build/一键信任.command"
        },
        {
          "x": 170,
          "y": 305
        },
        {
          "x": 470,
          "y": 305,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "pixel-clock",
    "electron",
    "widget",
    "dot-matrix",
    "cyberpunk"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
